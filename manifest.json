{
  "manifest_version": 3,
  "name": "Tab Dumper",
  "version": "2.0.1",
  "description": "Save and close tabs, search a private local archive, organise useful links and export them as Markdown.",
  "homepage_url": "https://viscioletti.com/tab-dumper",
  "incognito": "not_allowed",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "64": "assets/icons/icon-64.png",
    "128": "assets/icons/icon-128.png",
    "256": "assets/icons/icon-256.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src 'none'; img-src 'self' data:; font-src 'self'; style-src 'self'; frame-src 'none'"
  },
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "alarms",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Tab Dumper",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png"
    }
  }
}
