{
  "name": "tab-dumper",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "test:opera": "node scripts/test-opera.mjs",
    "test:chrome": "node tests/browser.mjs",
    "assets:chrome": "node scripts/chrome-assets.mjs && node scripts/store-assets.mjs chrome",
